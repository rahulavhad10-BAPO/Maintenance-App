# ============================================================================
# BUILDER POST-POSSESSION MAINTENANCE MANAGEMENT SYSTEM
# Environment Configuration Template (.env.example)
#
# NOTE: Never commit production secret keys into source control.
# Copy this file to .env and configure with your Supabase Project settings.
# ============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Safe for frontend client usage)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Storage Buckets (Private)
# Created via migration: complaints, quotations, evidence, voicenotes
VITE_SUPABASE_STORAGE_URL=https://your-project-id.supabase.co/storage/v1

# Note on Service Role Key:
# NEVER place SUPABASE_SERVICE_ROLE_KEY in frontend .env or client code!
# It belongs exclusively in server-side functions / n8n workflow credentials.
